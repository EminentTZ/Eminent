# Replace in production
SECRET_KEY=change-this-secret-key-in-production
# For local dev, SQLite (default if this is left unset). For a real deployment,
# point this at a Postgres database instead, e.g. a free one from neon.com:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./transport_system.db
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
